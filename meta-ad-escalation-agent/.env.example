# === Apify (provider "apify" — anúncios COMERCIAIS do Brasil) ===
# Token da sua conta Apify (https://console.apify.com/account/integrations).
# É o provider recomendado para pesquisar nichos e pegar anúncios do BR.
APIFY_TOKEN=

# Actor da Ad Library no Apify (opcional). Default: curious_coder/facebook-ads-library-scraper.
# Troque se preferir outro actor equivalente.
APIFY_ACTOR_ID=curious_coder~facebook-ads-library-scraper

# === Meta Ad Library (provider "graph" — só político/UE) ===
# Token do Graph API da Meta. Só cobre anúncios políticos/sociais (global) ou
# comerciais da UE. NÃO cobre comerciais do Brasil — para isso, use o Apify.
META_ACCESS_TOKEN=

# Versão da Graph API (opcional, default v21.0)
META_GRAPH_VERSION=v21.0

# === Anthropic (análise por IA do criativo) ===
# Se estiver usando `ant auth login`, pode deixar em branco.
ANTHROPIC_API_KEY=

# Modelo usado na análise (default claude-opus-4-8).
# Para reduzir custo em lote, pode trocar por claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-4-8
