# === Meta Ad Library ===
# Token do Graph API da Meta (App > Ferramentas > Explorador da Graph API, ou um token de sistema).
# Necessário para o provider "graph". Deixe em branco se for usar só o provider de exemplo/mock.
META_ACCESS_TOKEN=

# Versão da Graph API (opcional, default v21.0)
META_GRAPH_VERSION=v21.0

# === Anthropic (análise por IA do criativo) ===
# Se estiver usando `ant auth login`, pode deixar em branco.
ANTHROPIC_API_KEY=

# Modelo usado na análise (default claude-opus-4-8).
# Para reduzir custo em lote, pode trocar por claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-4-8
