{
  "name": "gerador-de-leads",
  "version": "0.1.0",
  "private": true,
  "description": "App desktop (macOS) para gerar listas de prospecção (cold outreach) raspando Google Maps, sites e bases de CNPJ — sem chaves pagas.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node build/make-icon.mjs",
    "dist": "npm run icon && electron-builder --mac"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ai.moldura.geradordeleads",
    "productName": "Gerador de Leads",
    "files": ["src/**/*", "renderer/**/*", "build/icon.png"],
    "mac": {
      "category": "public.app-category.business",
      "target": ["dmg", "zip"],
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "dist"
    }
  }
}
