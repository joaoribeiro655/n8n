# Chave da API do Apollo.io.
# Pegue em: Apollo > Settings > Integrations > API > "Create new key" (precisa de plano com acesso a API).
# Cole a chave aqui e renomeie este arquivo para ".env".
APOLLO_API_KEY="cole-sua-chave-aqui"

# (Opcional) URL base da API. Normalmente não precisa mexer.
# APOLLO_BASE_URL="https://api.apollo.io/api/v1"
