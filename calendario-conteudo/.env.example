# Banco de dados PostgreSQL.
# Em produção (Vercel) use o endereço do Neon/Vercel Postgres.
# Exemplo Neon: postgresql://user:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/calendario?schema=public"

# Segredo para assinar a sessão (login). Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-secret-troque-em-producao-com-no-minimo-32-caracteres"

# Guardador das imagens (Vercel Blob) — é aqui que as artes da galeria ficam.
# A Vercel preenche isso sozinha quando você ativa o Blob no painel (Storage).
# Se ficar vazio, as imagens são salvas localmente (apenas para desenvolvimento).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# === Robô diário (Vercel Cron) ===
# Segredo que protege a rota /api/cron/daily. A Vercel envia automaticamente
# "Authorization: Bearer <CRON_SECRET>" nos disparos agendados.
# CRON_SECRET="gere-um-valor-aleatorio-longo"
