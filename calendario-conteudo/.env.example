# Banco de dados PostgreSQL.
# Em produção (Vercel) use o endereço do Neon/Vercel Postgres.
# Exemplo Neon: postgresql://user:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/calendario?schema=public"

# Segredo para assinar a sessão (login). Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-secret-troque-em-producao-com-no-minimo-32-caracteres"

# Guardador de imagens na nuvem (Vercel Blob).
# A Vercel preenche isso sozinha quando você ativa o Blob no painel.
# Se ficar vazio, as imagens são salvas localmente (apenas para desenvolvimento).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# === Automação do Claude Design ===
# Webhook que recebe o briefing do post (JSON) e devolve { "imageUrl": "..." }.
# Pode ser um fluxo no n8n, uma function, ou um endpoint do Claude Design.
# Enquanto estiver vazio, a arte é enviada manualmente (upload/URL).
# CLAUDE_DESIGN_WEBHOOK_URL="https://seu-n8n/webhook/claude-design"
# Token opcional enviado como "Authorization: Bearer <token>".
# CLAUDE_DESIGN_WEBHOOK_TOKEN=""

# === Robô diário (Vercel Cron) ===
# Segredo que protege a rota /api/cron/daily. A Vercel envia automaticamente
# "Authorization: Bearer <CRON_SECRET>" nos disparos agendados.
# CRON_SECRET="gere-um-valor-aleatorio-longo"

# === Google Drive (destino das artes) ===
# Conta de serviço do Google com acesso ao Drive. Cole o JSON inteiro OU o JSON
# em base64 (mais fácil de colar na Vercel).
# GOOGLE_SERVICE_ACCOUNT_JSON='{"client_email":"...","private_key":"..."}'
# GOOGLE_SERVICE_ACCOUNT_B64="base64-do-json"
# Pasta raiz no Drive onde ficam as pastas dos clientes (/Cliente/Mês/).
# COMPARTILHE essa pasta com o e-mail da conta de serviço (permissão Editor).
# GDRIVE_ROOT_FOLDER_ID="id-da-pasta-raiz"
