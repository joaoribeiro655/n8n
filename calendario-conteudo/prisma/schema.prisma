// Calendário de Conteúdo — plataforma de planejamento, geração e aprovação de
// posts. Tudo acontece na própria plataforma: a arte é renderizada no servidor
// a partir do brand guide do cliente (cores, logo, fontes), guardada na galeria
// e aprovada por lá. Sem serviços externos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Um cliente da agência (ex.: "Copa"). Carrega o brand guide usado para
// renderizar as artes na identidade visual da marca.
model Tenant {
  id   String @id @default(cuid())
  slug String @unique
  name String

  // Brand guide (vem do projeto do Claude Design).
  primaryColor   String  @default("#0ea5e9")
  secondaryColor String  @default("#0b1220")
  accentColor    String  @default("#f59e0b")
  textColor      String  @default("#ffffff")
  fontFamily     String  @default("Inter")
  logoUrl        String?
  tagline        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  posts Post[]
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String
  role         String @default("OWNER") // OWNER | MEMBER

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  posts Post[]

  createdAt DateTime @default(now())
}

// Um post agendado no calendário do mês.
// A arte renderizada vive em PostVersion (v1, v2, v3...) para manter o histórico
// do ciclo de aprovação.
model Post {
  id       String   @id @default(cuid())
  date     DateTime // dia em que o post vai ao ar
  title    String? // título/destaque da arte
  copy     String   @default("") // legenda do post
  briefing String   @default("") // observações para a arte
  photoUrl String? // foto de fundo opcional da arte
  designHtml String? // design HTML gerado pelo Claude (Claude Design)
  status   String   @default("PLANNED") // PLANNED | GENERATED | APPROVED | REJECTED

  // Feedback deixado ao reprovar uma versão — alimenta a próxima v2/v3.
  feedback String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  versions PostVersion[]

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, date])
}

// Uma arte de um Post. O `version` incremental guarda o histórico v1/v2/v3;
// a versão mais recente é a arte atual em revisão.
model PostVersion {
  id       String  @id @default(cuid())
  version  Int
  imageUrl String
  html     String? // snapshot do design HTML que gerou esta arte
  note     String? // origem (Claude / enviada) ou o feedback que a gerou
  source   String  @default("CLAUDE") // CLAUDE (gerada pela IA) | UPLOAD (enviada)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, version])
}
